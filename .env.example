TZ=Europe/Amsterdam

# Zigbee coordinator.
# Linux + USB stick: prefer the stable by-id path from `ls -l /dev/serial/by-id/`, e.g.
#   /dev/serial/by-id/usb-ITead_Sonoff_Zigbee_3.0_USB_Dongle_Plus_<serial>-if00-port0
# /dev/ttyACM0 works too but can shift to ttyACM1 if another serial device enumerates first.
# This path is passed straight into the container and must exist on the host.
# Network coordinator (required on macOS/Windows Docker Desktop, where USB passthrough does
# not exist - also comment out the "devices:" block in docker-compose.yml): tcp://192.168.1.50:6638
Z2M_SERIAL_PORT=/dev/ttyACM0
# zstack | ember | deconz | zigate | zboss
Z2M_SERIAL_ADAPTER=zstack

Z2M_BASE_TOPIC=zigbee2mqtt

# Broker credentials. Required: the broker rejects anonymous clients.
# The same pair goes into Home Assistant's MQTT integration.
MQTT_USERNAME=smarthome
MQTT_PASSWORD=change-me

# Optional but recommended: lets switch rules drive lights through Home Assistant,
# which keeps Adaptive Lighting in control. Long-lived access token from your HA profile.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
